<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Isabella Bacalar — reconstrucción en Java (Spring MVC + Thymeleaf + MySQL)
      Empaquetado como WAR para desplegar en WildFly 22 (junto a sail.war).

      Elección de versiones:
        - Spring Boot 2.7.18 (última línea 2.x, usa el namespace javax.* que WildFly 22 provee).
        - Java 11 (WildFly 22 corre sobre Java 11).
        - MySQL Connector/J 8.0.x (compatible con MySQL 5.7).
      Build:  mvn clean package -DskipTests  ->  target/isabella.war
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>mx.isabellabacalar</groupId>
    <artifactId>isabella</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>Isabella Bacalar</name>
    <description>Sistema de gestion del Hotel Isabella (Bacalar)</description>

    <properties>
        <java.version>11</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Vistas Thymeleaf (incluye thymeleaf-layout-dialect para layout:decorate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Persistencia: JPA + JDBC (para entidades y JdbcTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validacion de formularios (Bean Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver MySQL (compatible con 5.7 y 8.x) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Tomcat embebido en 'provided': para el WAR no se empaqueta el contenedor,
          lo aporta WildFly. Si algun dia se corre como JAR standalone (:8083),
          cambiar este scope a 'compile'.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          FASE 3 (Auth): descomentar cuando se implemente Spring Security.
          <dependency>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-starter-security</artifactId>
          </dependency>
          <dependency>
              <groupId>org.thymeleaf.extras</groupId>
              <artifactId>thymeleaf-extras-springsecurity5</artifactId>
          </dependency>
        -->
    </dependencies>

    <build>
        <!-- Genera target/isabella.war (nombre estable para el deployment scanner) -->
        <finalName>isabella</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
